# ==================================================
# JARVIS AI — Environment Configuration (.env)
# ==================================================

# AI Provider selection: "nvidia", "ollama", "gemini", or "openai"
JARVIS_AI_PROVIDER=nvidia

# NVIDIA NIM / Build API (Free tier at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Local Ollama AI (Fallback or Offline)
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_TIMEOUT=60

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-Compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Voice Engine ("pyttsx3" or "edge-tts")
JARVIS_VOICE_ENGINE=pyttsx3
JARVIS_VOICE_RATE=175
JARVIS_VOICE_VOLUME=1.0
JARVIS_DEFAULT_LANG=en-US

# Server Port
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DEBUG=False
